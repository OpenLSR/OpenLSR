"res://textures/ui/op/controls/op8gvidlo.tga": PackedStringArray("res://i18n/textures/en/ui/op/controls/op8gvidlo.tga:en", "res://i18n/textures/ja/ui/op/controls/op8gvidlo.tga:ja"),
"res://textures/ui/op/controls/op8gvidmd.tga": PackedStringArray("res://i18n/textures/en/ui/op/controls/op8gvidmd.tga:en", "res://i18n/textures/ja/ui/op/controls/op8gvidmd.tga:ja"),
"res://textures/ui/op/controls/op8uvidhi.tga": PackedStringArray("res://i18n/textures/en/ui/op/controls/op8uvidhi.tga:en", "res://i18n/textures/ja/ui/op/controls/op8uvidhi.tga:ja"),
"res://textures/ui/op/controls/op8uvidlo.tga": PackedStringArray("res://i18n/textures/en/ui/op/controls/op8uvidlo.tga:en", "res://i18n/textures/ja/ui/op/controls/op8uvidlo.tga:ja"),
"res://textures/ui/op/controls/op8uvidmd.tga": PackedStringArray("res://i18n/textures/en/ui/op/controls/op8uvidmd.tga:en", "res://i18n/textures/ja/ui/op/controls/op8uvidmd.tga:ja"),
