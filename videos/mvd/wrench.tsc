{ NormalDriving   = 0008-0029   } normal driving - turn wheel subtley left and right 
{ LookLeft        = 0030-0044   } look left
{ LookRight       = 0045-0059   } look right
{ Brake           = 0060-0079   } brake - get pressed foward from stopping
{ TurnLeft        = 0080-0086   } turn left
{ TurnRight       = 0095-0101   } turn right
{ Bumps           = 0110-0130   } bumps - thrown up and down in car
{ SevereBumps     = 0140-0160   } severe bumps - thrown up and down in car more severely 
{ Jump            = 0187-0193   } jump - car bumps and rotates up slightly beforehand
{ Impact          = 0215-0249   } impact 1 - get thrown out of car
{ AccelerateHard  = 0250-0289   } accelerate hard/turbo - get pressed to back of seat
{ Scared          = 0290-0309   } scared - hands up to face
{ BarrelRoll      = 0310-0339   } barrel roll - turn wheel sharply beforehand
{ Happy           = 0340-0369   } happy 1 - nod head side to side
{ Yahoo           = 0370-0409   } yahoo - wave hands in air
{ Angry           = 0410-0449   } angry 1 - shake right fist in air
{ Reverse         = 0450-0463   } reverse - turn wheel and look over left shoulder
{ Bored1          = 0480-0509   } bored - yawn and hold hands up
{ Bored2          = 0510-0554   } bored - look at watch on left hand
{ Waiting         = 0555-0599   } waiting in anticipation - lean foward breathing
{ Invisible       = 0600-0606   } invisibility
{ Respawn      	  = 0623-0652   } respawn to black
{ Collision 	  = 0652-0665   } small collision
