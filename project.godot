; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OpenLSR"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.2", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://audio_layout.tres"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
mouse_cursor/custom_image="res://textures/ui/cursors/hand.png"
mouse_cursor/custom_image_hotspot=Vector2(10, 5)
mouse_cursor/tooltip_position_offset=Vector2(45, 60)

[dotnet]

project/assembly_name="OpenLSR"

[editor_plugins]

enabled=PackedStringArray("res://addons/MonoBuildToggler/plugin.cfg", "res://addons/lsr-mvd-importer/plugin.cfg")

[internationalization]

locale/translation_remaps={
"res://textures/ui/main_menu/button_bar.png": PackedStringArray("res://i18n/textures/ja/ui/main_menu/button_bar.png:ja"),
"res://textures/ui/op/controls/op8dvidhi.tga": PackedStringArray("res://i18n/textures/en/ui/op/controls/op8dvidhi.tga:en", "res://i18n/textures/ja/ui/op/controls/op8dvidhi.tga:ja"),
"res://textures/ui/op/controls/op8dvidlo.tga": PackedStringArray("res://i18n/textures/en/ui/op/controls/op8dvidlo.tga:en", "res://i18n/textures/ja/ui/op/controls/op8dvidlo.tga:ja"),
